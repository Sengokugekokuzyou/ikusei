# AI Navigator — environment variables
# Copy to `.env` and fill in. NEVER commit `.env` (see .gitignore, spec §67).

# --- LLM: text/reasoning providers ---
# Used by Researcher / Planner / Critic / Scorer (when providers.text != "mock").
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (otherwise the config defaults apply).
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o

# --- Later phases (not used in Phase 1) ---
# YOUTUBE_API_KEY=
# VOICEVOX_ENDPOINT=http://127.0.0.1:50021
